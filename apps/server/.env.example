# Локальная разработка. Скопируйте в apps/server/.env и задайте свои значения.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Рабочая роль приложения: нет права менять схему и переписывать журналы
DATABASE_URL=postgres://zapas_app:ПАРОЛЬ@127.0.0.1:5432/zapas
# Владелец схемы: им применяются миграции и загружается демо-набор
MIGRATION_DATABASE_URL=postgres://zapas_owner:ПАРОЛЬ@127.0.0.1:5432/zapas

# Не короче 32 символов: openssl rand -base64 48
JWT_SECRET=

BUSINESS_TZ=Europe/Moscow
