{
  "name": "@zapas/supplier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Отгрузка: кабинет поставщика, отдельная система, которая обменивается заказами с «Запасом»",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts && tsup",
    "start": "node dist/main.js",
    "seed": "tsx src/seed-cli.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.0",
    "@node-rs/argon2": "^2.2.0",
    "@zapas/shared": "*",
    "fastify": "^5.12.0",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "sass": "^1.105.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
