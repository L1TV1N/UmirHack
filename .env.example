# Скопируйте в .env и задайте свои значения. Пример команд для секретов:
#   openssl rand -hex 24      (пароли БД)
#   openssl rand -base64 48   (JWT_SECRET)

# База данных (для docker compose)
DB_ADMIN_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

# Подпись токенов доступа, не короче 32 символов, в production не должна быть похожа на пример
JWT_SECRET=

# Порт на локальной машине, наружу по умолчанию не публикуется
APP_PORT=3000

# Домен для боевого запуска за Caddy (docker-compose.prod.yml): на него Caddy сам получит сертификат.
# Домен должен указывать на сервер. Для проверки без своего домена подойдёт адрес вида 203-0-113-5.sslip.io
DOMAIN=

# Cookie с флагом Secure работают только по HTTPS (и на localhost).
# За обратным прокси с HTTPS оставьте true, для проверки по обычному http в локальной сети поставьте false.
COOKIE_SECURE=true

# Часовой пояс бизнеса: от него зависит, какой день считается «сегодня»
BUSINESS_TZ=Europe/Moscow

# Адреса, с которых разрешены запросы к API из браузера (через запятую). Для одного домена не нужно.
APP_ORIGINS=

# За обратным прокси: откуда брать адрес клиента из X-Forwarded-For (иначе ограничения по IP будут общими).
# Число прыжков до приложения (1, если перед ним один прокси) или список адресов прокси.
# Значение true доверяет любому заголовку, и клиент сможет подделать свой адрес.
TRUST_PROXY=false

# Telegram: сводка по утрам и сообщения о новых позициях в стоп-листе (оба значения или ни одного)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Если api.telegram.org недоступен напрямую (сервер в России), укажите SOCKS5-прокси: socks5://логин:пароль@IP:порт
TELEGRAM_PROXY_URL=

# Бот отвечает на команды (получает сообщения опросом). Один токен может опрашивать только один экземпляр,
# на остальных копиях поставьте false.
TELEGRAM_COMMANDS=true

# Почта (необязательно, оба значения или ни одного): письма поставщикам с заказами, временные пароли сотрудникам,
# коды подтверждения почты при регистрации организации. Без неё заказ отправляется без письма (причина видна в заказе),
# пароль показывается администратору на экране, адрес при регистрации не подтверждается.
SMTP_URL=
SMTP_FROM=

# Вебхуки со стоп-листом. По умолчанию разрешены только внешние https-адреса.
# Для приёмника во внутренней сети поставьте WEBHOOK_ALLOW_PRIVATE=true, для http без шифрования WEBHOOK_ALLOW_HTTP=true.
WEBHOOK_ALLOW_PRIVATE=false
WEBHOOK_ALLOW_HTTP=false

# Обмен с 1С. Сервер 1С чаще стоит во внутренней сети: перечислите его адрес (имя или IP, через запятую),
# и только для таких хостов разрешатся http и внутренние адреса. Остальным нужен https во внешней сети.
EXCHANGE_ALLOW_HOSTS=

# Распознавание фото накладной (необязательно). Без ключа загрузка фото выключена, УПД в XML работает всегда.
# Читает GigaChat: нужен ключ авторизации из кабинета разработчика (developers.sber.ru).
# Картинка уходит в сервис Сбера и сразу там удаляется, у нас не хранится.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
INVOICE_MODEL=GigaChat-2-Max
# Помощник («Помощник» в меню и вопросы боту): та же учётная запись GigaChat, лёгкая модель. off: только разбор по ключевым словам
ASSISTANT_MODEL=GigaChat-2
ASSISTANT_RATE_LIMIT=20
# Витрина «Спаси продукты»: сколько минут держится бронь, через сколько дней стираются имя и телефон гостя, броней с одного адреса за 10 минут
STOREFRONT_HOLD_MINUTES=120
STOREFRONT_RETENTION_DAYS=30
STOREFRONT_RESERVE_LIMIT=5
# Сертификат сервиса подписан российским корневым. Укажите путь к его файлу или на стенде отключите проверку.
GIGACHAT_CA_FILE=
GIGACHAT_INSECURE_TLS=false
