{
  "name": "zapas",
  "private": true,
  "version": "1.0.0",
  "description": "Учёт остатков, сроков годности и стоп-листов",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev -w @zapas/server",
    "dev:web": "npm run dev -w @zapas/web",
    "build": "npm run build -w @zapas/web && npm run build -w @zapas/server && npm run build -w @zapas/supplier",
    "start": "npm run start -w @zapas/server",
    "migrate": "npm run migrate -w @zapas/server",
    "seed": "npm run seed -w @zapas/server",
    "dev:supplier": "npm run dev -w @zapas/supplier",
    "seed:supplier": "npm run seed -w @zapas/supplier",
    "portal:sync": "npm run portal:sync -w @zapas/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "audit:prod": "npm audit --omit=dev",
    "create-admin": "npm run create-admin -w @zapas/server",
    "emulate": "npm run emulate -w @zapas/server --",
    "emulate:onec": "npm run emulate:onec -w @zapas/server --",
    "emulate:pos": "npm run emulate:pos -w @zapas/server --",
    "emulate:setup": "npm run emulate:setup -w @zapas/server --"
  },
  "devDependencies": {
    "npm-run-all2": "^8.0.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
